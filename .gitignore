# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Generated by PatchAI
data/index/
data/decisions.jsonl
data/training/*.jsonl
eval/results/*/full/
!eval/results/v2/full/

# Training outputs (large): keep manifests and loss curves, not weights
training/runs/*/checkpoints/
training/runs/*/merged/
training/runs/*/lora/
training/runs/*/gguf/
*.gguf
*.safetensors

# Editors / OS
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Temporary training cache
unsloth_compiled_cache/

# Additional generated model exports
training/runs/*/gguf_gguf/

# v2 runner
logs/
eval/results/smoke*/
training/runs/*/.exported
data/real_fixes/cache/

# Downloaded delivery folders and model files (never commit: 2 GB)
PatchAI_Final_Delivery*/
training/runs/*/.cache/

# Report builder
report/node_modules/

# Demo workspace (a scratch copy of the demo shop, recreated on demand)
data/demo_workspace/

# Written by training/export.py when a model is registered
training/runs/*/Modelfile

# The owner's local files
docs/reference/Markdown Live Preview.pdf
docs/reference/Project_Report-format.docx
